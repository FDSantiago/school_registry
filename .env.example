# Copy to .env and change the keys. Bun loads .env automatically.
# Variables already set in the environment (e.g. by the dev container) take precedence.

PORT=4000

# Host "mysql" is the MySQL service name inside docker compose / the dev container.
# sslmode=require is needed for MySQL 8.4's default login method (caching_sha2_password).
DATABASE_URL=mysql://registry:registry@mysql:3306/school_registry?sslmode=require
TEST_DATABASE_URL=mysql://registry:registry@mysql:3306/school_registry_test?sslmode=require

# API keys: at least 16 characters, and the two must differ.
# Generate one with: bun -e "console.log(crypto.randomUUID())"
REGISTRY_READ_KEY=change-me-read-key-0123456789
REGISTRY_ADMIN_KEY=change-me-admin-key-0123456789

# Requests allowed per API key per minute before 429.
RATE_LIMIT_PER_MINUTE=60

# docker compose only: host port mapped to the API's port 4000.
API_HOST_PORT=4000
